# Memepedia — variáveis de ambiente
# Copie para .env.local se quiser customizar; todos os valores são opcionais.

# Diretório onde o banco SQLite (memepedia.db + WAL) é guardado.
# Padrão: ./data
# MEMEPEDIA_DATA_DIR=./data

# Porta do servidor de desenvolvimento/produção.
# Padrão: 4310 (definida nos scripts "dev"/"start" do package.json)
# PORT=4310
